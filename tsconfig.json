{
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@db": ["./src/db"],
      "@db/*": ["./src/db/*"]
    }
  },
  "include": ["src", "app", "next-env.d.ts"]
}
